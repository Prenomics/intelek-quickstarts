# Copy to .env (git-ignored) and fill in.
# Same names as the keys of the Intelek secret object.
DB_HOST=localhost
DB_PORT=8123            # ClickHouse HTTP port; 8443 for HTTPS (e.g. ClickHouse Cloud)
DB_USER=default
DB_PASSWORD=''          # single quotes: keeps $, # and spaces literal
DB_NAME=pre_bizdoc      # existing database where every table is created
